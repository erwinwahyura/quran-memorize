// Cloudflare Workers (static assets + audio proxy + anonymous analytics).
// Deploy: npm run deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quran-memorize",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/audio/*", "/api/*"]
  },
  // Usage analytics. Wrangler creates this database automatically on the first
  // deploy; tables are created by the Worker on first use. Dashboard: /admin/
  // Set the dashboard password: npm run admin:hash, then
  //   npx wrangler secret put ADMIN_PASSWORD_HASH
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quran-memorize-analytics"
    }
  ]
}
